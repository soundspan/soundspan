{
    "name": "soundspan-backend",
    "version": "2.3.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "description": "soundspan backend API server",
    "license": "GPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/soundspan/soundspan.git"
    },
    "scripts": {
        "dev": "tsc -p ../packages/media-metadata-contract/tsconfig.json && tsx watch src/index.ts",
        "prebuild": "tsc -p ../packages/media-metadata-contract/tsconfig.json && tsx src/scripts/verifyNoIgnoredDataPaths.ts",
        "build": "tsc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "start": "node dist/index.js",
        "db:migrate": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "seed:user": "tsx seeds/createUser.ts",
        "pretest": "tsc -p ../packages/media-metadata-contract/tsconfig.json",
        "pretest:coverage": "tsc -p ../packages/media-metadata-contract/tsconfig.json",
        "pretest:integration": "tsc -p ../packages/media-metadata-contract/tsconfig.json",
        "pretest:scale": "tsc -p ../packages/media-metadata-contract/tsconfig.json",
        "test": "jest",
        "test:integration": "jest --config jest.integration.config.js --runInBand",
        "test:scale": "jest --config jest.scale.config.js --runInBand",
        "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=lcov --json --outputFile=coverage/jest-results.json",
        "test:smoke": "tsx scripts/smoke.ts",
        "test:smoke:mbid-auth": "tsx scripts/smoke-mbid-release-auth.ts",
        "test:smoke:subsonic-proxy": "tsx scripts/smoke-subsonic-proxy.ts",
        "test:analyzer:phase4": "tsx scripts/smoke-analyzer-phase4-regressions.ts",
        "test:manual:artist-normalization": "tsx scripts/manual-tests/artistNormalization.ts",
        "test:manual:download-dedup": "tsx scripts/manual-tests/downloadDedup.ts",
        "sync": "tsx src/workers/sync.ts",
        "create:testuser": "tsx scripts/create-test-user.ts",
        "generate:vocabulary": "tsx scripts/generateVibeVocabulary.ts"
    },
    "dependencies": {
        "@bull-board/api": "^8.6.1",
        "@bull-board/express": "^8.6.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@socket.io/redis-adapter": "^8.3.0",
        "@soundspan/media-metadata-contract": "file:../packages/media-metadata-contract",
        "archiver": "^8.0.0",
        "axios": "^1.19.0",
        "bcrypt": "^6.0.0",
        "bull": "^4.16.5",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "fluent-ffmpeg": "^2.1.3",
        "fuzzball": "^2.2.6",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.2.0",
        "music-metadata": "^11.14.0",
        "node-cron": "^4.6.0",
        "openid-client": "^6.8.5",
        "otplib": "^13.4.1",
        "p-limit": "^7.3.1",
        "p-queue": "^9.3.3",
        "prom-client": "^15.1.3",
        "qrcode": "^1.5.4",
        "redis": "^6.2.1",
        "rss-parser": "^3.13.0",
        "sharp": "^0.35.3",
        "slsk-client": "^1.1.0",
        "socket.io": "^4.8.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "umap-js": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/archiver": "^8.0.0",
        "@types/bcrypt": "^6.0.0",
        "@types/bull": "^4.10.4",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/fluent-ffmpeg": "^2.1.28",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^24",
        "@types/node-cron": "^3.0.11",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "jest": "^30.4.2",
        "pg": "^8.22.0",
        "prettier": "3.8.2",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "uuid@>=8.0.0 <11.1.1": "11.1.1",
        "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
}
