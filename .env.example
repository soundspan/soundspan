# soundspan Configuration
# Copy to .env and edit as needed

# ==============================================================================
# Database Configuration
# ==============================================================================
DATABASE_URL="postgresql://soundspan:soundspan@localhost:5433/soundspan"

# ==============================================================================
# Redis Configuration
# ==============================================================================
# Note: Redis container port is mapped to 6380 to avoid conflicts with other Redis instances
REDIS_URL="redis://localhost:6380"

# ==============================================================================
# OPTIONAL: Docker Compose Host Port Overrides
# ==============================================================================
# Split stack deployment defaults in docker-compose.yml:
# FRONTEND_PORT=3030
# BACKEND_PORT=3006
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# POSTGRES_PORT and REDIS_PORT bind to 127.0.0.1 only; see docs/UPGRADING.md
# for the override-file escape hatch when publishing on other interfaces.
#
# For backend API scale-out on a single Docker host, set:
# BACKEND_PORT=0
# so each backend replica can publish without host-port collisions.
#
# Optional services defaults in docker-compose.services.yml:
# LIDARR_PORT=8686
#
# Local host-run development (docker-compose.local.yml + npm run dev) intentionally
# uses +1 ports in docs/scripts (3007/3031/5433/6380) to avoid collisions.

# ==============================================================================
# REQUIRED: Path to your music library
# ==============================================================================
MUSIC_PATH=/path/to/your/music
# DEVELOPMENT: Use your local path (e.g., /home/user/Music)
# DOCKER: This is the HOST path that gets mounted to /music in the container
#         The backend inside Docker always uses /music, not this value.
#         Example: MUSIC_PATH=~/Music  (container mounts as ~/Music:/music)

# ==============================================================================
# REQUIRED: Security Keys
# ==============================================================================

# Encryption key for sensitive data (API keys, passwords, 2FA secrets)
# CRITICAL: You MUST set this before starting soundspan
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# JWT signing fallback (required, stable across restarts, and at least 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Required shared internal API secret for service-to-service callbacks
# Must be at least 32 characters and match across the backend, worker, and sidecars.
# Generate with: openssl rand -base64 32
# Sidecars/Compose reject the old published default value.
INTERNAL_API_SECRET=

# Bearer token required by Prometheus scrapers for /metrics.
# Generate with: openssl rand -base64 32
METRICS_TOKEN=

# WARNING: Exposes runtime and workload metrics without authentication.
# Use only on an isolated private network.
# METRICS_PUBLIC=false

# ==============================================================================
# OPTIONAL: OIDC / SSO Authentication
# ==============================================================================

# Hard rule: LOCAL_LOGIN_ENABLED=false requires OIDC_ENABLED=true to prevent
# every login method from being disabled.
# LOCAL_LOGIN_ENABLED=true
# OIDC_ENABLED=false

# These four values default to empty and are required when OIDC_ENABLED=true.
# OIDC_ISSUER_URL=https://idp.example/application/o/soundspan/
# OIDC_CLIENT_ID=soundspan
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://soundspan.example/api/auth/oidc/callback

# Set the canonical web origin when callbacks arrive on a different origin,
# such as a sibling API subdomain or a different port on the same host.
# Use an HTTP(S) origin only. A trailing slash is allowed and stripped.
# Hard rule: a non-empty value requires OIDC_ENABLED=true.
# OIDC_WEB_BASE_URL=https://music.example

# Requested OIDC scopes (default: openid profile email).
# OIDC_SCOPES="openid profile email"
# Allow direct provisioning from a private IdP (default: false).
# OIDC_AUTO_PROVISION=false

# Hard rule: OIDC_ADMIN_GROUP must be non-empty when OIDC_MANAGE_ROLES=true.
# OIDC_MANAGE_ROLES=false
# OIDC_GROUPS_CLAIM=groups
# OIDC_ADMIN_GROUP=

# Claim names and login-button provider label.
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# OIDC_PROVIDER_NAME=SSO

# ==============================================================================
# OPTIONAL: Customize these if needed
# ==============================================================================

# Allowed CORS origins (comma-separated). Only needed when the browser loads
# the frontend from a different origin than the backend API. When unset,
# production denies cross-origin browser requests (deny-by-default); see
# docs/UPGRADING.md. docker-compose.yml defaults this to the localhost origins.
# ALLOWED_ORIGINS=https://app.example.com

# Restore the legacy allow-any-origin CORS behavior when no ALLOWED_ORIGINS
# allowlist is configured (not recommended; prefer ALLOWED_ORIGINS).
# CORS_ALLOW_ALL=true

# Allow the Lidarr webhook to accept requests when no webhook secret is
# configured in System Settings (legacy fail-open behavior; not recommended —
# set a webhook secret instead). See docs/UPGRADING.md.
# LIDARR_WEBHOOK_ALLOW_UNAUTHENTICATED=true

# AIO/compose host publish port; the backend process itself defaults to 3006.
# PORT=3030

# Reverse proxy / cookies
# SECURE_COOKIES=true
# TRUST_PROXY_HOPS=1

# Timezone (default: UTC)
TZ=UTC

# Logging level (default: debug in development, warn in production)
# Options: debug, info, warn, error, silent
LOG_LEVEL=debug

# Frontend browser log level (build-time only for Next.js client bundle)
# Options: debug, info, warn, error, silent
# NEXT_PUBLIC_LOG_LEVEL=warn

# Frontend Content-Security-Policy rollout (runtime, server-side only).
# Report-only is the default. Set true only after reviewing violations across
# the documented browser workflows in docs/CONFIGURATION_AND_SECURITY.md.
# CSP_ENFORCE=false
# Optional root-relative or HTTPS report collector. soundspan does not provide
# a built-in collector endpoint.
# CSP_REPORT_URI=/csp-reports

# Playback engine (default: native — the native <audio>-element engine;
# see docs/NATIVE_AUDIO_ENGINE.md)
# STREAMING_ENGINE_MODE=native   # the default
# STREAMING_ENGINE_MODE=howler   # legacy fallback engine

# Backend runtime role:
# - all: combined API + workers
# - api: API/sockets only
# - worker: worker-only runtime (used by backend-worker profile/service)
# BACKEND_PROCESS_ROLE=all

# Initial delay before TCP keepalive probes reap vanished HTTP peers
# SOCKET_KEEPALIVE_DELAY_MS=30000

# Worker health endpoint port (worker runtime only)
# WORKER_HEALTH_PORT=3010

# Cross-replica Listen Together controls (keep enabled for scale-out)
# LISTEN_TOGETHER_REDIS_ADAPTER_ENABLED=true
# State sync requires the state store. Valid pairs are true/true, false/true,
# and false/false.
# LISTEN_TOGETHER_STATE_SYNC_ENABLED=true
# LISTEN_TOGETHER_STATE_STORE_ENABLED=true
# LISTEN_TOGETHER_STATE_STORE_TTL_SECONDS=21600
# LISTEN_TOGETHER_STATE_STORE_KEY_PREFIX=listen-together:state
# LISTEN_TOGETHER_MUTATION_LOCK_ENABLED=true
# Minimum 500 ms.
# LISTEN_TOGETHER_MUTATION_LOCK_TTL_MS=3000
# Must be at or below one third of the lock TTL.
# LISTEN_TOGETHER_MUTATION_LOCK_RENEW_INTERVAL_MS=1000
# Must be positive and lower than the lock TTL.
# LISTEN_TOGETHER_PUBLICATION_DEADLINE_MS=750
# LISTEN_TOGETHER_MUTATION_LOCK_PREFIX=listen-together:mutation-lock
# LISTEN_TOGETHER_RECONNECT_SLO_MS=5000
# SCHEDULER_CLAIM_SKIP_WARN_THRESHOLD=3
# DISCOVER_PROCESSOR_LOCK_TTL_MS=2700000
# ENRICHMENT_CLAIM_TTL_MS=900000
# MOOD_BUCKET_CLAIM_TTL_MS=120000
# TRACK_RECONCILIATION_MAX_ROWS=10000
# TRACK_RECONCILIATION_TIMEOUT_MS=600000

# Optional worker/database tuning
# DATABASE_POOL_SIZE=20
# DATABASE_POOL_TIMEOUT=30

# Browse thumbnail disk-cache bounds (image bytes plus metadata sidecars)
# BROWSE_IMAGE_CACHE_MAX_BYTES=268435456
# BROWSE_IMAGE_CACHE_MAX_ENTRIES=2048

# Allow public access to API documentation in production (default: false)
# Set to 'true' to make /api/docs accessible without authentication in production
# Development mode always allows public access
# DOCS_PUBLIC=true

# Coarse feature flags for ML/recommendation subsystems (default: true)
# Set to 'false' to disable a subsystem; its API prefixes return 404 and its
# background workers are not registered.
# AUDIO_ANALYSIS_ENABLED=true   # Audio analysis and DCLAP vibe embeddings, mood buckets, /api/analysis, /api/vibe
# AUDIO_ANALYSIS_QUEUE_MAX_DEPTH=100  # Maximum pending Redis jobs admitted for MusicCNN analysis
# VIBE_ANALYSIS_QUEUE_MAX_DEPTH=100   # Maximum pending provider embedding jobs
# VIBE_PROVIDER_URL=http://vibe-provider-dclap:8092  # Split-stack Compose default for vibe text and audio embeddings; override only for a custom provider.
# VIBE_EMBED_CONCURRENCY=1       # Backend provider audio jobs processed concurrently (1..32; default 1; size to ≈2× DCLAP replicas)
# VIBE_SPACE_CUTOVER_THRESHOLD=0.95  # Migrating-space eligible-track coverage required for automatic cutover (0.5..1)
# VIBE_SPACE_RETIREMENT_GRACE_DAYS=7 # Days to retain retired vectors for rollback before bounded cleanup (1..90)
# ANALYSIS_QUEUE_RESERVATION_TTL_SECONDS=3600  # Self-healing per-track enqueue reservation
# DISCOVERY_ENABLED=true        # Discover Weekly cron/processor, /api/discover, /api/recommendations
# AUTO_PLAYLISTS_ENABLED=true   # Made For You mixes on-demand generation, /api/mixes
# FEDERATION_ENABLED=false      # Peer credential admin + read-only /api/federation routes
# FEDERATION_TOMBSTONE_RETENTION_DAYS=90  # Deleted catalog identities retained for peer deltas; minimum 3
# PROVIDER_TRACK_RETENTION_DAYS=30  # Stale, unreferenced provider tracks retained before daily GC; 1..3650
# TRACK_REMOVAL_RETENTION_DAYS=90  # Soft-removed local tracks retained before permanent purge
# FEDERATION_SYNC_INTERVAL_MINUTES=15  # Consumer catalog sync interval; minimum 1
# FEDERATION_ALLOW_PRIVATE_PEERS=false  # Unsafe opt-in for peers on private/loopback/link-local addresses
# FEDERATION_ALLOW_PROXY=false  # Opt-in: honor HTTPS_PROXY/ALL_PROXY/NO_PROXY on federation egress (drops connection pinning)

# AIO image repository (defaults to GHCR)
SOUNDSPAN_AIO_IMAGE=ghcr.io/soundspan/soundspan

# Version tag (use 'latest' or specific like 'v1.0.0')
VERSION=latest

# ==============================================================================
# OPTIONAL: Audio Analyzer Configuration
# ==============================================================================

# Audio Analyzer CPU Control
# NUM_WORKERS=2                   # Number of parallel worker processes (1-8, default: 2)
# THREADS_PER_WORKER=1            # Threads per worker for TensorFlow/FFT (1-4, default: 1)
# Formula: max_cpu_usage ≈ WORKERS × (THREADS_PER_WORKER + 1) × 100%
# Example: 2 workers × (1 thread + 1 overhead) = ~400% CPU (4 cores)

# Audio Analyzer Timeout Configuration
# STALE_PROCESSING_MINUTES=15     # Timeout for tracks stuck in 'processing' state (default: 15)
#                                 # MUST match backend cleanup threshold to prevent race conditions
# MAX_ANALYZE_SECONDS=90          # Seconds of audio to analyze per track (default: 90)
#                                 # Limits memory usage - full tracks analyzed in chunks
# BATCH_SIZE=10                   # Number of tracks to process in parallel (default: 10)
# MAX_RETRIES=3                   # Maximum retry attempts per track before permanent failure (default: 3)

# Audio Analyzer Idle Optimization
# AUDIO_BRPOP_TIMEOUT=30          # Redis BRPOP timeout in seconds (default: 30)
#                                 # Also controls DB reconciliation interval
# AUDIO_MODEL_IDLE_TIMEOUT=300    # Seconds before unloading ML models when idle (default: 300)
#                                 # Set to 0 to keep models loaded permanently

# ==============================================================================
# OPTIONAL: TIDAL Streamer Configuration
# ==============================================================================

# Delay (in seconds) between downloading each track in an album.
# Prevents rate-limiting / bans from TIDAL's API.
# Set to 0 to disable (not recommended). Higher values are safer for large libraries.
# TIDAL_TRACK_DELAY=3

# ==============================================================================
# OPTIONAL: Lidarr Webhook Configuration
# ==============================================================================

# soundspan callback URL - How Lidarr can reach soundspan backend for webhooks
# DOCKER SAME-NETWORK: Use service name (http://backend:3006)
# DOCKER EXTERNAL: Use host IP (http://192.168.1.100:3006 or http://host.docker.internal:3006)
# STANDALONE LIDARR: Use external URL (http://yourserver:3006)
# Default: http://backend:3006 (assumes Lidarr and soundspan are on same Docker network)
SOUNDSPAN_CALLBACK_URL=http://backend:3006

# TROUBLESHOOTING: If you get "Name does not resolve (backend:3006)" errors in Lidarr logs:
# 1. Ensure Lidarr and Backend are on the same Docker network (default: soundspan_network)
# 2. Try using the service/network alias: http://backend:3006
# 3. Try using the host gateway: http://host.docker.internal:3006
# 4. Use your host's LAN IP: http://192.168.1.100:3006
#
# Solution:
# - Check networks: docker network inspect soundspan_network
# - If Lidarr is on different network, use external IP instead: http://<your-ip>:3006
# - Then update Lidarr → Settings → Connect → soundspan webhook URL to match
