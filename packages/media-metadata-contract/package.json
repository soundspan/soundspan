{
    "name": "@soundspan/media-metadata-contract",
    "version": "1.0.0",
    "engines": {
        "node": ">=24.0.0"
    },
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "devDependencies": {
        "prettier": "3.9.6",
        "typescript": "7.0.2"
    }
}
